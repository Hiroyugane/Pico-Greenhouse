# Binary artifacts — never run through EOL conversion. core.autocrlf would
# otherwise rewrite LF bytes inside these files on checkout and corrupt them.
*.pdf binary
*.pbix binary
*.png binary
*.jpg binary
*.mpy binary
*.uf2 binary

# Shell scripts must keep LF: they are executed inside WSL, where a CRLF
# shebang line makes bash report "bad interpreter" and CRLF heredoc markers
# never match their terminator.
*.sh text eol=lf
