# =============================================================
# OS / editor noise
# =============================================================
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*~
.history/
.idea/
*.iml
*.ipr
*.iws
.vs/
.vshistory/

# =============================================================
# VS Code
# Track shared workspace config, ignore everything else
# (no .vscode/ file in this repo contains absolute system paths;
# all use ${workspaceFolder} / ~ / $env:).
# =============================================================
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/Git-codebase.code-workspace
!.vscode/micropico-port.ps1
!.vscode/*.code-snippets

# =============================================================
# Python — bytecode, packaging, caches
# =============================================================
__pycache__/
*.py[codz]
*$py.class
*.so
*.egg
*.egg-info/
.eggs/
build/
dist/
sdist/
wheels/
.Python

# =============================================================
# Python — virtual environments and local env files
# =============================================================
.venv/
venv/
env/
ENV/
.env
.env.local
.env.*.local
.envrc

# =============================================================
# Python — test, coverage, lint, type-check caches
# =============================================================
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/
.coverage
.coverage.*
coverage.xml
htmlcov/

# =============================================================
# MicroPython — compiled bytecode (not pre-compiled today, but cheap to guard)
# =============================================================
*.mpy

# =============================================================
# Claude tooling — local-only, never tracked
# Includes the local fork of everything-claude-code under
# .claude/plugins-local/ which survives plugin re-installs.
# =============================================================
.claude/

# =============================================================
# Pi Greenhouse — local artifacts (runtime / scratch / vendored stubs)
# =============================================================
# Host-shim SD card mirror (runtime state from `python main.py`).
sd/
# Logger output produced by host runs.
*.csv
# Stray log files from prototypes/ and ad-hoc host runs.
*.log
# Captured SD-card output from prototype runs (incl. Windows volume cruft).
prototypes/logs/
# Diagnostic output from hardware probe scripts.
hw_probe_result.*
# Vendored MicroPython type stubs; excluded from lint and coverage
# in pyproject.toml — kept out of git on purpose.
typings/
# Local scratch / backup files.
service_reminder.txt
.main_original.py
# Generated by tools/build_update_payload.py; stamped per build.
lib/build_info.py

EasyEDA-Files/

graphify-out/
